config REGULATOR_MAX20356
	bool "MAX20356/MAX20358 PMIC regulator driver"
	default y
	depends on DT_HAS_ADI_MAX20356_REGULATOR_ENABLED
	depends on MFD_MAX20356
	help
	  Enable the Analog Devices MAX20356/MAX20358 PMIC regulator driver.
	  Each rail (buck1-3, buck-boost, ldo1-4, lsw1-3) is a devicetree child
	  node driven through the MAX20356 MFD parent.

if REGULATOR_MAX20356

config REGULATOR_MAX20356_COMMON_INIT_PRIORITY
	int "MAX20356 regulator driver init priority (common part)"
	default 86
	help
	  Init priority for the MAX20356/MAX20358 regulator driver (common
	  part). It must be greater than the MFD parent init priority.

config REGULATOR_MAX20356_INIT_PRIORITY
	int "MAX20356 regulator driver init priority"
	default 87
	help
	  Init priority for the MAX20356/MAX20358 regulator rails. It must be
	  greater than REGULATOR_MAX20356_COMMON_INIT_PRIORITY.

endif # REGULATOR_MAX20356

&i2c0 {
	status = "okay";

	pmic: max20356@28 {
		compatible = "adi,max20356";
		reg = <0x28>;
		status = "okay";
	};

	pmic58: max20358@29 {
		compatible = "adi,max20358";
		reg = <0x29>;
		status = "okay";
	};
};

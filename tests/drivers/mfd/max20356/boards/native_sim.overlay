&i2c0 {
	status = "okay";

	pmic: max20356@28 {
		compatible = "adi,max20356";
		reg = <0x28>;
		status = "okay";
		int-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;

		gpio_mpc: gpio {
			compatible = "adi,max20356-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <8>;
		};

		charger: charger {
			compatible = "adi,max20356-charger";
			constant-charge-current-microamp = <100000>;
			constant-charge-voltage-microvolt = <4200000>;
		};
	};

	pmic58: max20358@29 {
		compatible = "adi,max20358";
		reg = <0x29>;
		status = "okay";
	};
};
